datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ACCOUNTANT
  STAFF
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  BANK
  CAPITAL
  CASH
  INCOME
  EXPENSE
  OTHER_EXPENSE
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
}

enum DocStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  INVOICED
  BILLED
  POSTED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REVISED
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentMethod {
  CASH
  BANK
}

model User {
  id           Int      @id @default(autoincrement())
  loginId      String   @unique
  name         String
  email        String   @unique
  passwordHash String
  systemRole   Role     @default(STAFF)
  contact      Contact?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id         Int               @id @default(autoincrement())
  userId     Int?              @unique
  user       User?             @relation(fields: [userId], references: [id])
  name       String
  isCustomer Boolean           @default(false)
  isVendor   Boolean           @default(false)
  email      String            @unique
  phone      String
  city       String
  state      String
  pincode    String
  imageUrl   String?
  status     ActiveStatus      @default(ACTIVE)
  pos        PurchaseOrder[]
  bills      VendorBill[]
  sos        SalesOrder[]
  invoices   CustomerInvoice[]
  payments   Payment[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Product {
  id         Int                   @id @default(autoincrement())
  name       String                @unique
  sku        String?               @unique
  type       ProductType
  salesPrice Decimal               @db.Decimal(12, 2)
  costPrice  Decimal               @db.Decimal(12, 2)
  category   String
  stock      Int                   @default(0)
  status     ActiveStatus          @default(ACTIVE)
  poLines    PurchaseOrderLine[]
  billLines  VendorBillLine[]
  soLines    SalesOrderLine[]
  invLines   CustomerInvoiceLine[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model Account {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  type         AccountType
  journalItems JournalItem[]
  journals     Journal[]
  createdAt    DateTime      @default(now())
}

model Journal {
  id               Int            @id @default(autoincrement())
  name             String
  code             String         @unique
  type             JournalType
  defaultAccountId Int
  defaultAccount   Account        @relation(fields: [defaultAccountId], references: [id])
  entries          JournalEntry[]
  payments         Payment[]
  createdAt        DateTime       @default(now())
}

model JournalEntry {
  id          Int           @id @default(autoincrement())
  entryNumber String        @unique
  date        DateTime      @default(now())
  reference   String?
  journalId   Int
  journal     Journal       @relation(fields: [journalId], references: [id])
  status      DocStatus     @default(DRAFT)
  items       JournalItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model JournalItem {
  id                Int              @id @default(autoincrement())
  entryId           Int
  entry             JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId         Int
  account           Account          @relation(fields: [accountId], references: [id])
  partnerId         Int?
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  debit             Decimal          @default(0) @db.Decimal(12, 2)
  credit            Decimal          @default(0) @db.Decimal(12, 2)
  label             String?
}

model AnalyticAccount {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  type         AccountType
  budgets      Budget[]
  journalItems JournalItem[]
  createdAt    DateTime      @default(now())
}

model Budget {
  id                Int             @id @default(autoincrement())
  name              String
  periodStart       DateTime
  periodEnd         DateTime
  responsiblePerson String
  analyticAccountId Int
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  plannedAmount     Decimal         @db.Decimal(12, 2)
  committedAmount   Decimal         @default(0) @db.Decimal(12, 2)
  status            DocStatus       @default(CONFIRMED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  poNumber    String              @unique
  vendorId    Int
  vendor      Contact             @relation(fields: [vendorId], references: [id])
  date        DateTime            @default(now())
  status      DocStatus           @default(DRAFT)
  totalAmount Decimal             @db.Decimal(12, 2)
  lines       PurchaseOrderLine[]
  bills       VendorBill[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderLine {
  id        Int           @id @default(autoincrement())
  poId      Int
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId Int
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Decimal       @db.Decimal(10, 2)
  unitPrice Decimal       @db.Decimal(12, 2)
  subtotal  Decimal       @db.Decimal(12, 2)
}

model VendorBill {
  id              Int              @id @default(autoincrement())
  billNumber      String           @unique
  reference       String?
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  vendorId        Int
  vendor          Contact          @relation(fields: [vendorId], references: [id])
  billDate        DateTime         @default(now())
  dueDate         DateTime
  status          DocStatus        @default(DRAFT)
  totalAmount     Decimal          @db.Decimal(12, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(12, 2)
  journalEntryId  Int?
  lines           VendorBillLine[]
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model VendorBillLine {
  id        Int        @id @default(autoincrement())
  billId    Int
  bill      VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId Int
  product   Product    @relation(fields: [productId], references: [id])
  quantity  Decimal    @db.Decimal(10, 2)
  unitPrice Decimal    @db.Decimal(12, 2)
  subtotal  Decimal    @db.Decimal(12, 2)
}

model SalesOrder {
  id          Int               @id @default(autoincrement())
  soNumber    String            @unique
  customerId  Int
  customer    Contact           @relation(fields: [customerId], references: [id])
  date        DateTime          @default(now())
  status      DocStatus         @default(DRAFT)
  taxRate     Decimal           @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount Decimal           @db.Decimal(12, 2)
  lines       SalesOrderLine[]
  invoices    CustomerInvoice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SalesOrderLine {
  id        Int        @id @default(autoincrement())
  soId      Int
  so        SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  productId Int
  product   Product    @relation(fields: [productId], references: [id])
  quantity  Decimal    @db.Decimal(10, 2)
  unitPrice Decimal    @db.Decimal(12, 2)
  subtotal  Decimal    @db.Decimal(12, 2)
}

model CustomerInvoice {
  id             Int                   @id @default(autoincrement())
  invNumber      String                @unique
  salesOrderId   Int?
  salesOrder     SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  customerId     Int
  customer       Contact               @relation(fields: [customerId], references: [id])
  invoiceDate    DateTime              @default(now())
  dueDate        DateTime
  taxRate        Decimal               @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal               @db.Decimal(12, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(12, 2)
  journalEntryId Int?
  status         DocStatus             @default(DRAFT)
  lines          CustomerInvoiceLine[]
  payments       Payment[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model CustomerInvoiceLine {
  id        Int             @id @default(autoincrement())
  invId     Int
  invoice   CustomerInvoice @relation(fields: [invId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  quantity  Decimal         @db.Decimal(10, 2)
  unitPrice Decimal         @db.Decimal(12, 2)
  subtotal  Decimal         @db.Decimal(12, 2)
}

model Payment {
  id            Int              @id @default(autoincrement())
  paymentNumber String           @unique
  paymentType   PaymentType
  partnerId     Int
  partner       Contact          @relation(fields: [partnerId], references: [id])
  invoiceId     Int?
  invoice       CustomerInvoice? @relation(fields: [invoiceId], references: [id])
  billId        Int?
  bill          VendorBill?      @relation(fields: [billId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  journalId     Int
  journal       Journal          @relation(fields: [journalId], references: [id])
  date          DateTime         @default(now())
  status        DocStatus        @default(POSTED)
  createdAt     DateTime         @default(now())
}
